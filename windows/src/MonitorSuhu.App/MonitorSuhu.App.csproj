<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MonitorSuhu.ico</ApplicationIcon>
    <AssemblyName>MonitorSuhu</AssemblyName>
    <Product>MonitorSuhu</Product>
    <Version>1.0.13</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonitorSuhu.Core\MonitorSuhu.Core.csproj" />
    <ProjectReference Include="..\MonitorSuhu.Sensors\MonitorSuhu.Sensors.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="TaskScheduler" Version="2.11.0" />
  </ItemGroup>
</Project>
