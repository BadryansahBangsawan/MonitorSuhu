<Window x:Class="MonitorSuhu.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bara"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnDrag">
    <Border x:Name="HudRoot" CornerRadius="10" BorderThickness="1" Padding="12,9">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Locked}" Value="False">
                        <Setter Property="BorderBrush" Value="{Binding Accent}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Background>
            <SolidColorBrush Color="#0B0B0D" Opacity="{Binding Opacity}"/>
        </Border.Background>
        <StackPanel>
            <TextBlock Text="No sensors" Foreground="#8CFFFFFF"
                       FontFamily="{StaticResource HudFont}"
                       FontSize="{Binding FontSize}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding CompactLine}"
                       Foreground="{Binding CompactColor}"
                       FontFamily="{StaticResource HudFont}"
                       FontSize="{Binding FontSize}"
                       FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CompactHud}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CompactHud}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}"
                                       Foreground="#A6FFFFFF"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource HudFont}"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Grid Grid.Column="1" Height="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Width" Value="36"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowSparkline, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Width" Value="0"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Polyline Points="{Binding Points}"
                                          Stretch="Fill"
                                          Stroke="{Binding Color}"
                                          StrokeThickness="1.25"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                            </Grid>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Value}"
                                       Foreground="{Binding Color}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource HudFont}"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
