<Window x:Class="MonitorSuhu.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorSuhu Settings"
        Width="480" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#111111"
        Foreground="#EEEEEE">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}"/>
        </StackPanel>
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Overlay" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox Content="Show overlay" IsChecked="{Binding Settings.OverlayVisible}"/>
                <CheckBox Content="Lock overlay (click-through)" IsChecked="{Binding Settings.Locked}"/>
                <CheckBox Content="Start with Windows" IsChecked="{Binding Settings.StartWithWindows}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <Button Content="Top left" Command="{Binding TopLeftCommand}"/>
                    <Button Content="Top right" Command="{Binding TopRightCommand}"/>
                    <Button Content="Bottom left" Command="{Binding BottomLeftCommand}"/>
                    <Button Content="Bottom right" Command="{Binding BottomRightCommand}"/>
                    <Button Content="Edit overlay" Command="{Binding EditOverlayCommand}"/>
                </StackPanel>
                <TextBlock Text="Hotkeys: Ctrl+Shift+T show/hide, Ctrl+Shift+E edit layout" Opacity="0.7" Margin="0,4,0,12"/>

                <TextBlock Text="Sensors" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/>
                <CheckBox Content="CPU" IsChecked="{Binding Settings.ShowCpu}"/>
                <CheckBox Content="GPU" IsChecked="{Binding Settings.ShowGpu}"/>
                <CheckBox Content="SSD" IsChecked="{Binding Settings.ShowSsd}"/>
                <CheckBox Content="Motherboard" IsChecked="{Binding Settings.ShowBoard}"/>
                <CheckBox Content="RAM (only if a sensor exists)" IsChecked="{Binding Settings.ShowRam}"/>

                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <CheckBox Content="Use Fahrenheit" IsChecked="{Binding Settings.UseFahrenheit}"/>
                <TextBlock Text="Opacity"/>
                <Slider Minimum="0.4" Maximum="0.95" Value="{Binding Settings.OverlayOpacity}"/>
                <TextBlock Text="Font size"/>
                <Slider Minimum="11" Maximum="18" Value="{Binding Settings.FontSize}"/>
                <TextBlock Text="Poll interval (ms)"/>
                <TextBox Text="{Binding Settings.PollIntervalMs}" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
