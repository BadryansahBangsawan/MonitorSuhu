<Window x:Class="MonitorSuhu.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorSuhu Settings"
        MinWidth="540" MinHeight="580"
        Width="560" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        Foreground="#EEEEEE"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#76B900"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,8,0,0"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="CaretBrush" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="88"
                    Background="#76B900" BorderBrush="#76B900" Foreground="#111111" FontWeight="SemiBold"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Overlay" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Show overlay" IsChecked="{Binding OverlayVisible}"/>
                        <CheckBox Content="Lock overlay" IsChecked="{Binding Locked}"
                                  ToolTip="When locked, clicks pass through the HUD."/>
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="May ask for administrator permission so the overlay still has sensor access after reboot."
                           Style="{StaticResource Caption}" Margin="2,0,0,14"/>

                <TextBlock Text="Position" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,6,0,8">
                            <Button Content="Top left" Command="{Binding TopLeftCommand}" Margin="0,0,8,8" HorizontalAlignment="Stretch"/>
                            <Button Content="Top right" Command="{Binding TopRightCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                            <Button Content="Bottom left" Command="{Binding BottomLeftCommand}" Margin="0,0,8,0" HorizontalAlignment="Stretch"/>
                            <Button Content="Bottom right" Command="{Binding BottomRightCommand}" HorizontalAlignment="Stretch"/>
                        </UniformGrid>
                        <Button Content="Edit overlay" Command="{Binding EditOverlayCommand}" HorizontalAlignment="Left" Margin="0,4,0,6"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Unlock, then drag the HUD. It snaps to edges and remembers the corner."
                           Style="{StaticResource Caption}" Margin="2,0,0,14"/>

                <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Toggle overlay" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding ToggleHotkeyDisplay}" FontFamily="Consolas" Foreground="#BBBBBB"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Edit layout" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding EditHotkeyDisplay}" FontFamily="Consolas" Foreground="#BBBBBB"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="Ctrl+Shift+T shows or hides the HUD. Ctrl+Shift+E unlocks it so you can drag."
                           Style="{StaticResource Caption}" Margin="2,0,0,14"/>

                <TextBlock Text="Sensors" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding SensorError}"
                                   Foreground="#FF8A80"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSensorError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <CheckBox Content="CPU" IsChecked="{Binding ShowCpu}"/>
                        <CheckBox Content="GPU" IsChecked="{Binding ShowGpu}"/>
                        <CheckBox Content="SSD" IsChecked="{Binding ShowSsd}"/>
                        <CheckBox Content="Motherboard" IsChecked="{Binding ShowBoard}"/>
                        <CheckBox Content="RAM" IsChecked="{Binding ShowRam}"
                                  ToolTip="Hidden in the HUD when this PC has no RAM temperature sensor."/>
                    </StackPanel>
                </Border>
                <TextBlock Text="RAM is omitted from the HUD when this PC has no sensor for it."
                           Style="{StaticResource Caption}" Margin="2,0,0,14"/>

                <TextBlock Text="Thresholds" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sensor" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" Margin="0,0,0,6"/>
                        <TextBlock Grid.Column="1" Text="Warn" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Grid.Column="3" Text="Crit" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Text="CPU" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CpuWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CpuCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="2" Text="GPU" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GpuWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding GpuCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="3" Text="SSD" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SsdWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding SsdCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="4" Text="Board" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BoardWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding BoardCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="5" Text="RAM" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RamWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding RamCrit, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </Border>
                <TextBlock Text="Warn turns the reading yellow. Critical turns it red. Values are always in °C."
                           Style="{StaticResource Caption}" Margin="2,0,0,14"/>

                <TextBlock Text="Polling" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="0,6,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Poll interval" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding PollIntervalLabel}" Foreground="#8A8A8A" FontFamily="Consolas"/>
                        </Grid>
                        <Slider Minimum="400" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True"
                                Value="{Binding PollIntervalMs}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="How often sensors are read. 1000 ms is a good default."
                           Style="{StaticResource Caption}" Margin="2,0,0,14"/>

                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Use Fahrenheit" IsChecked="{Binding UseFahrenheit}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding OpacityLabel}" Foreground="#8A8A8A" FontFamily="Consolas"/>
                        </Grid>
                        <Slider Minimum="0.4" Maximum="0.95" Value="{Binding OverlayOpacity}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font size" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding FontSizeLabel}" Foreground="#8A8A8A" FontFamily="Consolas"/>
                        </Grid>
                        <Slider Minimum="11" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding FontSize}"/>
                        <TextBlock Text="Accent" Margin="0,8,0,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Accents}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Hex"
                                  SelectedValue="{Binding AccentHex}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
