<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MonitorSuhu.Linux.Views.SettingsWindow"
        Title="MonitorSuhu Settings"
        MinWidth="540" MinHeight="580"
        Width="560" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        Foreground="#EEEEEE"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A"/>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,8,0,0"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="CaretBrush" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="88"
                    Background="#76B900" BorderBrush="#76B900" Foreground="#111111" FontWeight="SemiBold"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#243018"
                        BorderBrush="#2E2E2E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,8"
                        Margin="0,0,0,8"
                        IsVisible="{Binding Updates.BannerVisible}">
                    <StackPanel Margin="0,4,0,4">
                        <TextBlock Text="{Binding Updates.UpdateMessage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Updates.UpdateHint}" TextWrapping="Wrap"
                                   Foreground="#B8C9A0" FontSize="12" Margin="0,6,0,0"/>
                        <ProgressBar Height="6" Margin="0,12,0,2" Minimum="0" Maximum="1"
                                     Value="{Binding Updates.Progress}"
                                     Foreground="#76B900"
                                     IsVisible="{Binding Updates.Installing}"/>
                        <Button Content="Install update…" Command="{Binding ApplyUpdateCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Background="#76B900" BorderBrush="#76B900" Foreground="#111111" FontWeight="SemiBold"
                                IsVisible="{Binding Updates.ShowInstallButton}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Overlay" Classes="section"/>
                <Border Classes="card">
                    <StackPanel>
                        <CheckBox Content="Show overlay" IsChecked="{Binding OverlayVisible}"/>
                        <CheckBox Content="Lock overlay" IsChecked="{Binding Locked}"
                                  ToolTip.Tip="{Binding LockCaption}"/>
                        <CheckBox Content="Start with Linux" IsChecked="{Binding StartWithWindows}"/>
                        <CheckBox Content="Hide in fullscreen" IsChecked="{Binding HideInFullscreen}"
                                  ToolTip.Tip="Off keeps the HUD on games. On hides when the active window is _NET_WM_STATE_FULLSCREEN."/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding AutoHideCaption}"
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Alerts" Classes="section"/>
                <Border Classes="card">
                    <StackPanel>
                        <CheckBox Content="Critical alerts" IsChecked="{Binding AlertsEnabled}"
                                  ToolTip.Tip="Tray tooltip plus notify-send when a visible reading crosses critical."/>
                        <Button Content="Mute 15 minutes" Command="{Binding MuteAlertsCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,6"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding MuteCaption}"
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Position" Classes="section"/>
                <Border Classes="card">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,6,0,8">
                            <Button Content="Top left" Command="{Binding TopLeftCommand}" Margin="0,0,8,8" HorizontalAlignment="Stretch"/>
                            <Button Content="Top right" Command="{Binding TopRightCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                            <Button Content="Bottom left" Command="{Binding BottomLeftCommand}" Margin="0,0,8,0" HorizontalAlignment="Stretch"/>
                            <Button Content="Bottom right" Command="{Binding BottomRightCommand}" HorizontalAlignment="Stretch"/>
                        </UniformGrid>
                        <Button Content="Edit overlay" Command="{Binding EditOverlayCommand}" HorizontalAlignment="Left" Margin="0,4,0,6"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Unlock, then drag the HUD. It snaps to edges and remembers the corner."
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Shortcuts" Classes="section"/>
                <Border Classes="card">
                    <StackPanel>
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Toggle overlay" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding RecordToggleCommand}" Padding="8,4" ToolTip.Tip="Click to rebind">
                                <TextBlock Text="{Binding ToggleHotkeyDisplay}" FontFamily="monospace" Foreground="#BBBBBB"/>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Edit layout" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding RecordEditCommand}" Padding="8,4" ToolTip.Tip="Click to rebind">
                                <TextBlock Text="{Binding EditHotkeyDisplay}" FontFamily="monospace" Foreground="#BBBBBB"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ShortcutsCaption}"
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Sensors" Classes="section"/>
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="{Binding SensorError}"
                                   Foreground="#FF8A80"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,8"
                                   IsVisible="{Binding HasSensorError}"/>
                        <CheckBox Content="CPU" IsChecked="{Binding ShowCpu}"/>
                        <CheckBox Content="GPU" IsChecked="{Binding ShowGpu}"/>
                        <CheckBox Content="SSD" IsChecked="{Binding ShowSsd}"/>
                        <CheckBox Content="Motherboard" IsChecked="{Binding ShowBoard}"/>
                        <CheckBox Content="RAM" IsChecked="{Binding ShowRam}"
                                  ToolTip.Tip="Hidden in the HUD when this PC has no RAM temperature sensor."/>
                        <CheckBox Content="Fan" IsChecked="{Binding ShowFan}"
                                  ToolTip.Tip="Hidden in the HUD when this PC has no fan RPM sensor."/>
                        <CheckBox Content="CPU load" IsChecked="{Binding ShowCpuLoad}"
                                  ToolTip.Tip="Off by default. Hidden when this PC has no CPU utilization reading."/>
                        <CheckBox Content="GPU load" IsChecked="{Binding ShowGpuLoad}"
                                  ToolTip.Tip="Off by default. Hidden when this PC has no GPU utilization reading."/>
                        <CheckBox Content="Power" IsChecked="{Binding ShowPower}"
                                  ToolTip.Tip="Off by default. Hidden when this PC has no hwmon power reading."/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Extra rows stay off until you turn them on. Missing sensors stay omitted, same as RAM and fan."
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Assignments" Classes="section"/>
                <Border Classes="card">
                    <StackPanel Margin="0,6,0,6">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ThermalOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding CpuBinding}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ThermalOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding GpuBinding}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SSD" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ThermalOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding SsdBinding}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Board" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ThermalOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding BoardBinding}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RAM" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ThermalOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding RamBinding}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fan" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding FanOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding FanBinding}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU%" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LoadOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding CpuLoadBinding}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU%" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LoadOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding GpuLoadBinding}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PWR" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PowerOptions}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}"
                                      SelectedValue="{Binding PowerBinding}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="Auto uses name tokens (tdie, nand, …). Pick a row to pin that sensor."
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Thresholds" Classes="section"/>
                <Border Classes="card">
                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sensor" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" Margin="0,0,0,6"/>
                        <TextBlock Grid.Column="1" Text="Warn" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Grid.Column="3" Text="Crit" FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Text="CPU" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CpuWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CpuCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="2" Text="GPU" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GpuWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding GpuCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="3" Text="SSD" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SsdWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding SsdCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="4" Text="Board" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BoardWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding BoardCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="5" Text="RAM" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RamWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding RamCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="6" Text="Fan" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FanWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding FanCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="7" Text="CPU%" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CpuLoadWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding CpuLoadCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="8" Text="GPU%" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding GpuLoadWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="8" Grid.Column="3" Text="{Binding GpuLoadCrit, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="9" Text="PWR" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding PowerWarn, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="9" Grid.Column="3" Text="{Binding PowerCrit, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </Border>
                <TextBlock Text="Warn turns the reading yellow. Critical turns it red. Temperatures are °C, fans are RPM, load is %, power is watts."
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Polling" Classes="section"/>
                <Border Classes="card">
                    <StackPanel Margin="0,6,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Poll interval" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding PollIntervalLabel}" Foreground="#8A8A8A" FontFamily="monospace"/>
                        </Grid>
                        <Slider Minimum="400" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True"
                                Value="{Binding PollIntervalMs}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="How often sensors are read. 1000 ms is a good default."
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Profile" Classes="section"/>
                <Border Classes="card">
                    <UniformGrid Columns="3" Margin="0,6,0,6">
                        <Button Content="Desktop" Command="{Binding ApplyDesktopCommand}" Margin="0,0,8,0" HorizontalAlignment="Stretch"/>
                        <Button Content="Game" Command="{Binding ApplyGameCommand}" Margin="0,0,8,0" HorizontalAlignment="Stretch"/>
                        <Button Content="Silent" Command="{Binding ApplySilentCommand}" HorizontalAlignment="Stretch"/>
                    </UniformGrid>
                </Border>
                <TextBlock Text="{Binding ProfileCaption}"
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="Appearance" Classes="section"/>
                <Border Classes="card">
                    <StackPanel>
                        <CheckBox Content="Use Fahrenheit" IsChecked="{Binding UseFahrenheit}"/>
                        <CheckBox Content="Compact HUD" IsChecked="{Binding CompactHud}"/>
                        <CheckBox Content="Sparkline (30 samples)" IsChecked="{Binding ShowSparkline}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding OpacityLabel}" Foreground="#8A8A8A" FontFamily="monospace"/>
                        </Grid>
                        <Slider Minimum="0.4" Maximum="0.95" Value="{Binding OverlayOpacity}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font size" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding FontSizeLabel}" Foreground="#8A8A8A" FontFamily="monospace"/>
                        </Grid>
                        <Slider Minimum="11" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding FontSize}"/>
                        <TextBlock Text="Accent" Margin="0,8,0,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Accents}"
                                  DisplayMemberBinding="{Binding Name}"
                                  SelectedValueBinding="{Binding Hex}"
                                  SelectedValue="{Binding AccentHex}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Compact puts every sensor on one line. Sparkline is the last 30 polls."
                           Classes="caption" Margin="2,0,0,14"/>

                <TextBlock Text="About" Classes="section" Margin="0,16,0,8"/>
                <Border Classes="card">
                    <StackPanel Margin="0,6,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Version" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Updates.CurrentVersion}" Foreground="#8A8A8A" FontFamily="monospace"/>
                        </Grid>
                        <Button Content="Check for Updates…" Command="{Binding CheckUpdatesCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Install from Settings replaces this folder. Settings stay in ~/.config/MonitorSuhu."
                           Classes="caption" Margin="2,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
