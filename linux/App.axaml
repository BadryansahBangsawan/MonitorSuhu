<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MonitorSuhu.Linux.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#76B900"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#F5C518"/>
        <SolidColorBrush x:Key="CritBrush" Color="#FF3B30"/>
        <!-- Fluent controls (sliders, selection, focus) follow the brand green. -->
        <Color x:Key="SystemAccentColor">#76B900</Color>
        <Color x:Key="SystemAccentColorLight1">#86C81A</Color>
        <Color x:Key="SystemAccentColorLight2">#8FD12A</Color>
        <Color x:Key="SystemAccentColorLight3">#A5DD52</Color>
        <Color x:Key="SystemAccentColorDark1">#6AA600</Color>
        <Color x:Key="SystemAccentColorDark2">#5E9400</Color>
        <Color x:Key="SystemAccentColorDark3">#4F7D00</Color>
    </Application.Resources>
</Application>
