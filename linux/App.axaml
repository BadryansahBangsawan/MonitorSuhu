<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MonitorSuhu.Linux.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#76B900"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#F5C518"/>
        <SolidColorBrush x:Key="CritBrush" Color="#FF3B30"/>
    </Application.Resources>
</Application>
